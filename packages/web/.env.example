# Base URL of the deployed HTTP API, without /v1. The SAM stack output ApiUrl.
VITE_API_URL=https://ivaqlw3t8d.execute-api.ap-south-1.amazonaws.com

# Serve the fixtures in src/mocks instead of calling the API. Off unless set to true.
# In `npm run dev` the top bar also has a toggle; production builds never show it.
VITE_USE_MOCKS=false

# The MCP endpoint shown in the context panel. Leave unset until the MCP service is
# deployed — the panel hides the section rather than showing an address that does not work.
VITE_MCP_URL=
