{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "paths": {
      "@dune/shared": ["./packages/shared/src/index.ts"],
      "@dune/shared/*": ["./packages/shared/src/*.ts"],
      "@dune/indexer/embed": ["./packages/indexer/src/embed.ts"],
      "@dune/indexer/errors": ["./packages/indexer/src/lib/errors.ts"],
      "@dune/indexer/storage": ["./packages/indexer/src/lib/db.ts"],
      "@dune/indexer/vectors": ["./packages/indexer/src/lib/vectors.ts"],
      "@dune/indexer/clone": ["./packages/indexer/src/clone.ts"]
    }
  }
}
