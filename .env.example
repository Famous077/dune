# Copy to .env (gitignored). `npm run deploy` reads it and passes these to the stack as
# NoEcho parameters; they become environment variables on the Lambdas.

# Generation. GENERATOR picks the provider; only that provider's key is required.
GENERATOR=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. A fine-grained GitHub token with public-repository read-only access and no other
# permissions. Raises the GitHub limit from 60 requests an hour to 5,000.
GITHUB_TOKEN=

# Optional overrides; the deploy script has defaults.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low
# GROQ_MODEL=openai/gpt-oss-120b
# CONTEXT_TOKEN_CAP=30000
